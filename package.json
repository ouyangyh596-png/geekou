{
  "name": "so-fine-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "validate:content": "node scripts/validate-content.mjs && pnpm test-content",
    "test-content": "node scripts/test-site-content.mjs",
    "test-language": "node scripts/test-language.mjs",
    "test-scroll": "node scripts/test-scroll-navigation.mjs",
    "test-header-directory": "node scripts/test-header-product-directory.mjs",
    "test-request-validation": "node scripts/test-request-validation.mjs",
    "test-api": "node scripts/test-api.mjs",
    "test-media": "node scripts/test-media-manifest.mjs",
    "test-product-media": "node scripts/test-product-media-semantics.mjs",
    "test-home-media": "node scripts/test-home-media.mjs",
    "test-product-wheel": "node scripts/test-product-wheel-navigation.mjs",
    "test-category-media": "node scripts/test-category-media.mjs",
    "test-accessibility-assets": "node scripts/test-accessibility-assets.mjs",
    "test-printable-wrap": "node scripts/test-printable-wrap-state.mjs",
    "test-printable-wrap-scene": "node scripts/test-printable-wrap-scene.mjs && node scripts/test-printable-wrap-webgl.mjs",
    "test-printable-wrap-viewer": "node scripts/test-printable-wrap-viewer.mjs",
    "test-printable-wrap-configurator": "node scripts/test-printable-wrap-configurator.mjs",
    "test-rendered-ui": "node scripts/test-rendered-ui.mjs",
    "test-cybertruck": "node scripts/test-cybertruck-config.mjs && node scripts/test-cybertruck-scene.mjs",
    "test-polish": "node scripts/test-site-polish.mjs",
    "test-typography": "node scripts/test-typography.mjs",
    "test-release": "pnpm validate:content && pnpm test-polish && pnpm test-typography && pnpm test-cybertruck && pnpm test-scroll && pnpm test-language && pnpm test-home-media && pnpm test-product-wheel && pnpm test-category-media && pnpm test-accessibility-assets && pnpm test-printable-wrap"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.185.1",
    "vite": "latest"
  }
}
